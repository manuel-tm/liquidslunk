# Copy to .env, which every npm script loads.

# The database. Slunk only writes next to it: the -wal/-shm files and
# slunk-backups/. In development, keep it in the scratch library.
SLUNK_DB=dev-library/slunk.db

# How many backups slunk-backups/ keeps. Each migration backs the database up
# first, then removes the oldest backups beyond this. Default 10.
# SLUNK_KEEP_BACKUPS=10

# The port the server listens on, on 127.0.0.1. The frontend's Vite proxy
# expects 4000.
# PORT=4000
