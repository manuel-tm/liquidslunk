{
  "name": "slunk-be",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "db:gen": "node --env-file-if-exists=.env src/repo/cli.ts gen",
    "db:migrate": "node --env-file-if-exists=.env src/repo/cli.ts migrate",
    "db:rollback": "node --env-file-if-exists=.env src/repo/cli.ts rollback",
    "db:status": "node --env-file-if-exists=.env src/repo/cli.ts status",
    "db:seed": "node --env-file-if-exists=.env src/repo/cli.ts seed",
    "db:reset": "node --env-file-if-exists=.env src/repo/cli.ts reset",
    "codegen": "graphql-codegen",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.ts\""
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "better-sqlite3": "^12.11.1",
    "dataloader": "^2.2.3",
    "express": "^5.3.0",
    "graphql": "^16.14.2",
    "kysely": "^0.29.6",
    "music-metadata": "^12.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-resolvers": "^6.1.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "kysely-codegen": "^0.20.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "@apollo/protobufjs": false
  }
}
