# Local prompting assets: the folder is committed, its contents never are (see AGENTS.md)
/temp/*
!/temp/.gitkeep

# Scratch libraries for development, with copies of real music: the folder is
# committed, its contents never are (see AGENTS.md)
/dev-library/*
!/dev-library/.gitkeep

# Dependencies and builds
node_modules/
dist/
dist-ssr/
/target/
# Tauri's generated capability schemas
/src-tauri/gen/schemas/
*.local

# Logs
logs
*.log
npm-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# macOS Finder metadata
.DS_Store
